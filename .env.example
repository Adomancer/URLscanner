# Copy to .env and fill in what you need. Every setting is optional and has a safe default.
# .env is git-ignored: never commit the real file.

# --- Web UI ---------------------------------------------------------------------------------
# Required for the Mail pages, and whenever anyone but you can reach the web UI (e.g. Docker).
SCANNER_ACCESS_TOKEN=
# Flask session key. Generated and kept in outputs/.secret_key when empty.
SECRET_KEY=
FLASK_DEBUG=0
# 1 = allow port scans from the web UI (the CLI always has --active --i-am-authorized).
SCANNER_WEB_ACTIVE=0
# 1 = take the client IP from X-Forwarded-For. Only behind your own reverse proxy.
SCANNER_TRUST_PROXY=0
# Extra host names the Mail pages answer to besides localhost (comma-separated), e.g. scanner.lan
SCANNER_ALLOWED_HOSTS=

# --- Gmail scanner --------------------------------------------------------------------------
# A Google App Password (2-Step Verification -> https://myaccount.google.com/apppasswords).
# It gives FULL mailbox access over IMAP: keep it here only and revoke it when unused.
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
GMAIL_IMAP_HOST=imap.gmail.com
# What analysing e-mail links may touch. Links are never opened either way.
#   dns  = DNS + WHOIS lookups of the registered domain
#   none = no network connection at all (WHOIS only from the local cache)
SCANNER_MAIL_NETWORK=dns
# Seconds of analysis per message, and size limits.
SCANNER_MAIL_TIME_BUDGET=60
SCANNER_MAIL_MAX_MESSAGE_BYTES=26214400
SCANNER_MAIL_MAX_RUN_BYTES=209715200

# --- Threat feeds (tools/update_feeds.py) ---------------------------------------------------
# Free key from your abuse.ch account; without it the URLhaus feed is skipped.
ABUSECH_AUTH_KEY=

# --- Scanning -------------------------------------------------------------------------------
SCANNER_HTTP_TIMEOUT=10
SCANNER_MAX_BODY_BYTES=16777216
SCANNER_MAX_REDIRECTS=10
SCANNER_SANDBOX_TIMEOUT=20
# SCANNER_USER_AGENT=Mozilla/5.0 ...
# Only for local testing: lets the scanner reach private/loopback addresses (disables SSRF protection).
SCANNER_ALLOW_PRIVATE=0

# --- Storage --------------------------------------------------------------------------------
# SCANNER_OUTPUT_DIR=outputs
# SCANNER_DB=outputs/scans.db
